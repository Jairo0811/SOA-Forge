{
  "Gateway": {
    "Jwt": {
      "Issuer": "SOAForge.Gateway",
      "Audience": "SOAForge.NovaCommerce",
      "SigningKey": "SOAForge-Development-Only-Signing-Key-Change-Me-2026",
      "LifetimeMinutes": 60
    },
    "DemoUser": {
      "Username": "demo",
      "Password": "SOAForge2026!",
      "Role": "operator"
    },
    "Portal": {
      "AllowedOrigins": [
        "http://localhost:5173"
      ]
    },
    "Services": {
      "CustomerService": {
        "BaseUrl": "http://localhost:5101"
      },
      "OrderService": {
        "BaseUrl": "http://localhost:5102"
      },
      "PaymentService": {
        "BaseUrl": "http://localhost:5103"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "customers-v1": {
        "ClusterId": "customers",
        "AuthorizationPolicy": "gateway",
        "Match": {
          "Path": "/api/v1/customers/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/customers/{**remainder}"
          }
        ]
      },
      "orders-v1": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "gateway",
        "Match": {
          "Path": "/api/v1/orders/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/orders/{**remainder}"
          }
        ]
      },
      "payments-v1": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "gateway",
        "Match": {
          "Path": "/api/v1/payments/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/payments/{**remainder}"
          }
        ]
      }
    },
    "Clusters": {
      "customers": {
        "Destinations": {
          "customer-service": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "orders": {
        "Destinations": {
          "order-service": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "payments": {
        "Destinations": {
          "payment-service": {
            "Address": "http://localhost:5103/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*"
}
